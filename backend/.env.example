# Copy to backend/.env and fill in.
# Required: signs login tokens (>= 32 chars). The API refuses to start without it. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# At least one cloud LLM key is required. Order tried: 1min.ai -> Gemini -> OpenAI.
ONEMIN_API_KEY=
ONEMIN_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
OPENAI_API_KEY=
